# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://afromations:secret@localhost:5432/afromations
DATABASE_URL_SYNC=postgresql://afromations:secret@localhost:5432/afromations

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=afromations-assets
MINIO_SECURE=false

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AFROMATIONS Studio Core
DEBUG=false

# ── External AI APIs (optional — system uses mocks if not set) ────────────────
OPENAI_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
