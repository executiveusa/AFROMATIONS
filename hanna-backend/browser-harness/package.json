{
  "name": "@afromations/browser-harness",
  "version": "1.0.0",
  "description": "Hana browser-control harness — secure CDP/Playwright automation with policy enforcement and audit logging",
  "type": "module",
  "bin": {
    "hermes": "./dist/cli/hermes.js"
  },
  "scripts": {
    "dev": "tsx src/cli/hermes.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "operator": "tsx src/operator/console.ts",
    "test": "node --test --require tsx/cjs tests/smoke.ts",
    "test:smoke": "tsx tests/smoke.ts",
    "install:browser": "npx playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "commander": "^12.1.0",
    "pino": "^9.2.0",
    "playwright": "^1.43.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.8.0"
  }
}
