# ── Browser Harness Configuration ────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# Browser launch mode
BROWSER_HEADLESS=true
BROWSER_DEBUG_PORT=9222
BROWSER_PROFILE_DIR=.browser-profile

# Origin access control (comma-separated, empty = no restriction)
BROWSER_ALLOWED_ORIGINS=
BROWSER_BLOCKED_ORIGINS=

# Approval flow
# Set to false ONLY in dev/test — risky actions bypass approval gate
BROWSER_REQUIRE_APPROVAL=true

# Capture settings
BROWSER_CAPTURE_SCREENSHOTS=true
BROWSER_CAPTURE_NETWORK=true

# Rate limiting (requests per minute per session)
BROWSER_RATE_LIMIT_RPM=60

# Session management
BROWSER_SESSION_TIMEOUT_MS=300000
BROWSER_MAX_SESSIONS=3

# Audit log output directory
AUDIT_LOG_DIR=./audit-logs

# Operator console
OPERATOR_PORT=7700
# Required to call operator API endpoints
OPERATOR_API_KEY=change-me-operator-secret

# Runtime environment
NODE_ENV=development
