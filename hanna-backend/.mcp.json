{
  "mcpServers": {
    "unified-browser": {
      "command": "python",
      "args": ["tools/unified-browser-mcp/server.py"],
      "description": "Browser control for all agent personalities (Hanna, Director, Sensei, Alpha, Beta, Gamma)",
      "timeout": 300,
      "tools": [
        "create_session",
        "navigate",
        "get_text",
        "get_html",
        "screenshot",
        "click",
        "fill",
        "evaluate",
        "close_session",
        "list_sessions"
      ]
    },
    "blender": {
      "command": "python",
      "args": ["tools/blender-mcp/server.py"],
      "env": {
        "BLENDER_PATH": "${BLENDER_PATH:-blender}",
        "RENDER_MODE": "${RENDER_MODE:-local}",
        "TEMPLATES_DIR": "${TEMPLATES_DIR}"
      },
      "tools": [
        "create_anime_avatar",
        "render_scene",
        "apply_kupuri_shader",
        "export_web_avatar",
        "list_templates"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}"
      },
      "tools": [
        "query",
        "insert",
        "update",
        "storage_upload",
        "storage_list"
      ]
    },
    "openmontage": {
      "command": "python",
      "args": ["tools/openmontage-mcp/server.py"],
      "tools": [
        "list_pipelines",
        "create_project",
        "add_scene",
        "render_video",
        "get_project_status"
      ]
    },
    "manga-creator": {
      "command": "python",
      "args": ["tools/manga-creator-mcp/server.py"],
      "tools": [
        "create_manga",
        "add_page",
        "add_panel",
        "add_text_bubble",
        "render_page",
        "export_manga"
      ]
    },
    "character-creator": {
      "command": "python",
      "args": ["tools/character-creator-mcp/server.py"],
      "env": {
        "CC4_DIR": "${CC4_DIR}",
        "REALLUSION_TEMPLATES": "${REALLUSION_TEMPLATES}",
        "REALLUSION_CUSTOM": "${REALLUSION_CUSTOM}"
      },
      "tools": [
        "list_templates",
        "load_template",
        "customize_character",
        "export_character",
        "get_character_status"
      ]
    },
    "browser": {
      "command": "python",
      "args": ["tools/browser-mcp/server.py"],
      "env": {
        "CHROME_DEBUG_PORT": "${CHROME_DEBUG_PORT:-9222}"
      },
      "tools": [
        "navigate",
        "screenshot",
        "click",
        "fill_form",
        "extract_data",
        "get_page_info"
      ]
    },
    "seedance": {
      "command": "python",
      "args": ["tools/seedance-mcp/server.py"],
      "env": {
        "REPLICATE_API_TOKEN": "${REPLICATE_API_TOKEN}"
      },
      "tools": [
        "generate_video",
        "check_video_status",
        "generate_explainer"
      ]
    },
    "hana-browser": {
      "command": "npx",
      "args": ["tsx", "browser-harness/src/mcp/server.ts"],
      "description": "Hana browser-control harness — production CDP/Playwright automation with policy enforcement, audit logging, and operator approval gate",
      "timeout": 60000,
      "env": {
        "BROWSER_HEADLESS": "${BROWSER_HEADLESS:-true}",
        "BROWSER_DEBUG_PORT": "${BROWSER_DEBUG_PORT:-9222}",
        "BROWSER_PROFILE_DIR": "${BROWSER_PROFILE_DIR:-.browser-profile}",
        "BROWSER_ALLOWED_ORIGINS": "${BROWSER_ALLOWED_ORIGINS}",
        "BROWSER_BLOCKED_ORIGINS": "${BROWSER_BLOCKED_ORIGINS}",
        "BROWSER_REQUIRE_APPROVAL": "${BROWSER_REQUIRE_APPROVAL:-true}",
        "BROWSER_CAPTURE_SCREENSHOTS": "${BROWSER_CAPTURE_SCREENSHOTS:-true}",
        "BROWSER_CAPTURE_NETWORK": "${BROWSER_CAPTURE_NETWORK:-true}",
        "BROWSER_RATE_LIMIT_RPM": "${BROWSER_RATE_LIMIT_RPM:-60}",
        "BROWSER_SESSION_TIMEOUT_MS": "${BROWSER_SESSION_TIMEOUT_MS:-300000}",
        "BROWSER_MAX_SESSIONS": "${BROWSER_MAX_SESSIONS:-3}",
        "OPERATOR_API_KEY": "${OPERATOR_API_KEY}",
        "NODE_ENV": "${NODE_ENV:-production}"
      },
      "tools": [
        "browser_open",
        "browser_goto",
        "browser_click",
        "browser_type",
        "browser_press",
        "browser_screenshot",
        "browser_get_dom",
        "browser_get_text",
        "browser_get_console_logs",
        "browser_get_network_logs",
        "browser_wait_for",
        "browser_evaluate_sandboxed",
        "browser_close",
        "browser_reset_session",
        "browser_list_sessions"
      ]
    }
  }
}
