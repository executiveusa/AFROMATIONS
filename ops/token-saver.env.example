# TOKEN SAVER PROTOCOL — Cost Guard Defaults
# Source this file in every session: source ops/.env.token-saver
# These are NOT secrets — safe to commit

# Daily spending limit (USD)
TOKEN_BUDGET_DAILY=50

# Per-task spending limit (USD)
TOKEN_BUDGET_TASK=10

# Minimum acceptable compression ratio (60-90% target)
COMPRESSION_FLOOR=0.65

# Dependencies required for this repo
JCODEMUNCH_REQUIRED=true
RTK_REQUIRED=true

# NIM (NVIDIA Inference) Configuration
NVIDIA_NIM_BASE_URL=http://31.220.58.212:8082
NVIDIA_NIM_API_KEY=dummy
NVIDIA_NIM_MODEL=moonshotai/kimi-k2-thinking
NVIDIA_NIM_RATE_LIMIT=40

# Supabase (existing backend)
# Note: Add real values to .env.local or via Cloudflare secrets

# Cost reporting
COST_REPORT_DIR=ops/reports
COST_REPORT_FORMAT=json
